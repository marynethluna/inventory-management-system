NODE_ENV=development
PORT=4000
# Optional: connect to a persistent MongoDB deployment instead of in-memory storage.
# MONGODB_URI=mongodb://127.0.0.1:27017/school_inventory
# Generate a private value with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
# Explicit browser origins allowed by the API. Use the deployed client URL in production.
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Optional first-run administrator bootstrap. No account is seeded unless these are set.
# Use a unique email and a private password; these values are never committed.
# INITIAL_ADMIN_NAME=Inventory Administrator
# INITIAL_ADMIN_EMAIL=admin@your-school.example
# INITIAL_ADMIN_PASSWORD=choose-a-private-password-with-at-least-8-characters

# Optional SMTP transport for password reset delivery. In development, links are
# written to the server console if SMTP_HOST is not configured.
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# MAIL_FROM=School Inventory <no-reply@example.edu>
